    <!-- Onboarding -->
    <string name="onb_welcome_title">Dictate in any app</string>
    <string name="onb_welcome_body">Tap the bubble, speak, then tap ✓. Your words go into the text field you\'re in.</string>
    <string name="onb_mic_title">Microphone</string>
    <string name="onb_mic_why">Records your voice while you dictate.</string>
    <string name="onb_mic_not">It doesn\'t listen at any other time, and keeps no recordings.</string>
    <string name="onb_notif_title">Notifications</string>
    <string name="onb_notif_why">Shows a notification with Stop and Cancel while you dictate.</string>
    <string name="onb_notif_not">It never shows ads or reminders.</string>
    <string name="onb_unlock_title">Allow restricted settings</string>
    <string name="onb_unlock_why">Android blocks accessibility services of apps installed from a file until you allow it.</string>
    <string name="onb_unlock_1">Open App info.</string>
    <string name="onb_unlock_2">Tap ⋮ at the top, then Allow restricted settings.</string>
    <string name="onb_unlock_3">Come back here.</string>
    <string name="onb_unlock_hint">No such option? Try once to turn on Burble in accessibility settings, then look again.</string>
    <string name="onb_insert_title">Accessibility service</string>
    <string name="onb_insert_why">Shows the bubble over other apps and types your words into the text field you\'re in. Android has no other way for an app to do this.</string>
    <string name="onb_insert_not">It doesn\'t read your screen, log what you type or send anything anywhere.</string>
    <string name="onb_insert_how">In accessibility settings, find Burble and turn it on.</string>
