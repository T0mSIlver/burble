<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cleartext to localhost only, for a fake update release served over adb reverse. -->
    <application android:networkSecurityConfig="@xml/debug_network">
        <!-- Only holders of DUMP (adb shell) may send to it; release builds lack it. -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".DebugFieldsActivity"
            android:exported="true" />
    </application>
</manifest>
